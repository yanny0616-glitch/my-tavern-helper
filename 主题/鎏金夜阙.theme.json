{
  "formatVersion": 1,
  "templateMeta": {
    "kind": "importable-theme",
    "description": "「鎏金·夜阙」— 深靛夜色配鎏金强调，衬线排版，适合暗光环境。在 SP·数据库 的 设置 → 主题 → 导入主题 中选择本文件即可使用。"
  },
  "theme": {
    "id": "@yanny/gilded-night",
    "name": "鎏金·夜阙",
    "description": "深靛夜幕，鎏金为饰，星阙藏典之意，宋体排版",
    "author": "yanny",
    "version": "1.0.0",
    "colorScheme": "dark",
    "variables": {
      "--acu-bg-0": "#131020",
      "--acu-bg-1": "#1b1730",
      "--acu-bg-2": "rgba(233, 221, 255, 0.05)",
      "--acu-bg-3": "rgba(233, 221, 255, 0.08)",
      "--acu-border": "rgba(216, 194, 255, 0.14)",
      "--acu-border-2": "rgba(224, 197, 132, 0.38)",
      "--acu-text-1": "#f0eadf",
      "--acu-text-2": "#cfc6b8",
      "--acu-text-3": "#8d8578",
      "--acu-accent": "#d9b36a",
      "--acu-accent-2": "#e8cd8f",
      "--acu-accent-glow": "rgba(217, 179, 106, 0.18)",
      "--acu-accent-glow-2": "rgba(217, 179, 106, 0.10)",
      "--acu-success": "#86c9a8",
      "--acu-warning": "#e0aa4e",
      "--acu-danger": "#e08484",
      "--acu-radius-lg": "12px",
      "--acu-radius-md": "9px",
      "--acu-radius-sm": "7px",
      "--acu-shadow": "0 16px 48px rgba(8, 6, 20, 0.60)",

      "--bg-primary": "var(--acu-bg-0)",
      "--bg-secondary": "var(--acu-bg-1)",
      "--background_light": "rgba(233, 221, 255, 0.04)",
      "--background_default": "rgba(233, 221, 255, 0.03)",
      "--background-color-light": "rgba(233, 221, 255, 0.04)",
      "--input-background": "rgba(10, 8, 20, 0.35)",
      "--input-text-color": "var(--acu-text-1)",
      "--button-background": "rgba(233, 221, 255, 0.06)",
      "--button-secondary-background": "rgba(233, 221, 255, 0.04)",
      "--text-main": "var(--acu-text-1)",
      "--text_primary": "var(--acu-text-1)",
      "--text_secondary": "var(--acu-text-2)",
      "--text_tertiary": "var(--acu-text-3)",
      "--text-color": "var(--acu-text-1)",
      "--text-color-dimmed": "var(--acu-text-3)",
      "--border_color": "var(--acu-border)",
      "--border_color_light": "var(--acu-border)",
      "--border-normal": "var(--acu-border-2)",
      "--warning-color": "var(--acu-warning)",
      "--error-color": "var(--acu-danger)",
      "--green": "var(--acu-success)",
      "--orange": "var(--acu-warning)",
      "--red": "var(--acu-danger)",
      "--accent-primary": "var(--acu-accent)",

      "--acu-control-bg": "rgba(10, 8, 20, 0.35)",
      "--acu-control-text": "var(--acu-text-1)",
      "--acu-select-arrow": "var(--acu-text-2)",
      "--acu-radio-accent": "var(--acu-accent)",
      "--acu-radio-bg": "var(--acu-control-bg)",
      "--acu-checkbox-bg": "rgba(10, 8, 20, 0.45)",
      "--acu-checkbox-checked-bg": "var(--acu-accent)",
      "--acu-checkbox-checked-border": "var(--acu-accent)",
      "--acu-checkbox-checked-icon": "#191430",
      "--acu-danger-soft-bg": "rgba(224, 132, 132, 0.12)",
      "--acu-danger-soft-border": "rgba(224, 132, 132, 0.32)",
      "--acu-overlay-bg": "rgba(10, 8, 22, 0.45)",
      "--acu-overlay-backdrop-blur": "4px",
      "--acu-confirm-bg": "var(--acu-bg-1)",
      "--acu-confirm-border": "var(--acu-border)",
      "--acu-confirm-title": "var(--acu-text-1)",
      "--acu-confirm-text": "var(--acu-text-2)",
      "--acu-confirm-cancel-bg": "transparent",
      "--acu-confirm-cancel-border": "var(--acu-border-2)",
      "--acu-confirm-cancel-text": "var(--acu-text-2)",
      "--acu-confirm-cancel-hover-bg": "var(--acu-bg-2)",
      "--acu-confirm-cancel-hover-border": "var(--acu-border)",
      "--acu-confirm-cancel-hover-text": "var(--acu-text-1)",
      "--acu-confirm-ok-bg": "rgba(217, 179, 106, 0.14)",
      "--acu-confirm-ok-border": "rgba(217, 179, 106, 0.36)",
      "--acu-confirm-ok-text": "var(--acu-accent)",
      "--acu-confirm-ok-hover-bg": "rgba(217, 179, 106, 0.22)",
      "--acu-confirm-ok-hover-border": "rgba(217, 179, 106, 0.50)"
    },
    "fontFamily": "\"Noto Serif SC\", \"Source Han Serif CN\", \"Songti SC\", \"STSong\", \"SimSun\", serif",
    "customCSS": "/* 鎏金·夜阙：header 前缀金印 */\n#popup .acu-header::before {\n    content: '典';\n    display: inline-flex;\n    align-items: center;\n    justify-content: center;\n    width: 22px;\n    height: 22px;\n    border: 1px solid var(--acu-accent);\n    color: var(--acu-accent);\n    font-size: 12px;\n    border-radius: 3px;\n    opacity: 0.9;\n    letter-spacing: 1px;\n    flex-shrink: 0;\n    box-shadow: 0 0 8px var(--acu-accent-glow);\n}\n#popup .acu-header {\n    background: linear-gradient(180deg, rgba(217, 179, 106, 0.06), transparent);\n    box-shadow: none;\n    border-bottom: 1px solid rgba(217, 179, 106, 0.22);\n}\n/* 金色聚焦描边 */\n#popup input:focus, #popup textarea:focus, #popup select:focus {\n    outline: 1px solid rgba(217, 179, 106, 0.55);\n    outline-offset: -1px;\n}\n/* 表头淡金染色 */\n#popup table th {\n    background: rgba(217, 179, 106, 0.07);\n}",
    "windowChromeVariables": {
      "--acu-panel-bg": "var(--acu-bg-1)",
      "--acu-panel-border": "var(--acu-border)",
      "--acu-panel-text": "var(--acu-text-1)",
      "--acu-panel-text-dim": "var(--acu-text-2)",
      "--acu-panel-text-mute": "var(--acu-text-3)",
      "--acu-panel-accent": "var(--acu-accent)",
      "--acu-panel-hover": "var(--acu-bg-2)",
      "--acu-panel-shadow": "var(--acu-shadow)",
      "--acu-panel-close-hover-bg": "var(--acu-danger-soft-bg)",
      "--acu-panel-close-hover-border": "var(--acu-danger-soft-border)",
      "--acu-panel-close-hover-text": "var(--acu-danger)"
    },
    "toastVariables": {},
    "visualizerVariables": {},
    "previewColors": {
      "bg": "#131020",
      "card": "#1b1730",
      "accent": "#d9b36a",
      "text": "#f0eadf"
    }
  }
}
