{
  "formatVersion": 1,
  "templateMeta": {
    "kind": "importable-theme",
    "description": "「鎏金·晨光」— 暖纸浅色配金褐强调，衬线排版，与「鎏金·夜阙」成对的日间主题。在 SP·数据库 的 设置 → 主题 → 导入主题 中选择本文件即可使用。"
  },
  "theme": {
    "id": "@yanny/gilded-dawn",
    "name": "鎏金·晨光",
    "description": "暖纸晨色，金褐为饰，与夜阙成对的日间主题，宋体排版",
    "author": "yanny",
    "version": "1.0.0",
    "colorScheme": "light",
    "variables": {
      "--acu-bg-0": "#f6f2e9",
      "--acu-bg-1": "#fffcf5",
      "--acu-bg-2": "rgba(120, 96, 48, 0.05)",
      "--acu-bg-3": "rgba(120, 96, 48, 0.08)",
      "--acu-border": "#e6ddc9",
      "--acu-border-2": "rgba(154, 122, 50, 0.40)",
      "--acu-text-1": "#353026",
      "--acu-text-2": "#6a6355",
      "--acu-text-3": "#a09884",
      "--acu-accent": "#9a7328",
      "--acu-accent-2": "#b08d3f",
      "--acu-accent-glow": "rgba(154, 115, 40, 0.12)",
      "--acu-accent-glow-2": "rgba(154, 115, 40, 0.08)",
      "--acu-success": "#4e8d6b",
      "--acu-warning": "#b97c17",
      "--acu-danger": "#c25e5e",
      "--acu-radius-lg": "12px",
      "--acu-radius-md": "9px",
      "--acu-radius-sm": "7px",
      "--acu-shadow": "0 2px 10px rgba(90, 75, 40, 0.10)",

      "--bg-primary": "var(--acu-bg-0)",
      "--bg-secondary": "var(--acu-bg-1)",
      "--background_light": "rgba(255, 252, 245, 0.60)",
      "--background_default": "rgba(255, 252, 245, 0.45)",
      "--background-color-light": "rgba(255, 252, 245, 0.50)",
      "--input-background": "#fffdf8",
      "--input-text-color": "var(--acu-text-1)",
      "--button-background": "rgba(255, 252, 245, 0.70)",
      "--button-secondary-background": "rgba(255, 252, 245, 0.50)",
      "--text-main": "var(--acu-text-1)",
      "--text_primary": "var(--acu-text-1)",
      "--text_secondary": "var(--acu-text-2)",
      "--text_tertiary": "var(--acu-text-3)",
      "--text-color": "var(--acu-text-1)",
      "--text-color-dimmed": "var(--acu-text-3)",
      "--border_color": "var(--acu-border)",
      "--border_color_light": "var(--acu-border)",
      "--border-normal": "var(--acu-border-2)",
      "--warning-color": "var(--acu-warning)",
      "--error-color": "var(--acu-danger)",
      "--green": "var(--acu-success)",
      "--orange": "var(--acu-warning)",
      "--red": "var(--acu-danger)",
      "--accent-primary": "var(--acu-accent)",

      "--acu-control-bg": "#fffdf8",
      "--acu-control-text": "var(--acu-text-1)",
      "--acu-select-arrow": "var(--acu-text-2)",
      "--acu-radio-accent": "var(--acu-accent)",
      "--acu-radio-bg": "var(--acu-control-bg)",
      "--acu-checkbox-bg": "#fffdf8",
      "--acu-checkbox-checked-bg": "var(--acu-accent)",
      "--acu-checkbox-checked-border": "var(--acu-accent)",
      "--acu-checkbox-checked-icon": "#fffaf0",
      "--acu-danger-soft-bg": "rgba(194, 94, 94, 0.10)",
      "--acu-danger-soft-border": "rgba(194, 94, 94, 0.28)",
      "--acu-overlay-bg": "rgba(60, 50, 30, 0.20)",
      "--acu-overlay-backdrop-blur": "3px",
      "--acu-confirm-bg": "var(--acu-bg-1)",
      "--acu-confirm-border": "var(--acu-border)",
      "--acu-confirm-title": "var(--acu-text-1)",
      "--acu-confirm-text": "var(--acu-text-2)",
      "--acu-confirm-cancel-bg": "transparent",
      "--acu-confirm-cancel-border": "var(--acu-border-2)",
      "--acu-confirm-cancel-text": "var(--acu-text-2)",
      "--acu-confirm-cancel-hover-bg": "var(--acu-bg-2)",
      "--acu-confirm-cancel-hover-border": "var(--acu-border)",
      "--acu-confirm-cancel-hover-text": "var(--acu-text-1)",
      "--acu-confirm-ok-bg": "rgba(154, 115, 40, 0.10)",
      "--acu-confirm-ok-border": "rgba(154, 115, 40, 0.32)",
      "--acu-confirm-ok-text": "var(--acu-accent)",
      "--acu-confirm-ok-hover-bg": "rgba(154, 115, 40, 0.18)",
      "--acu-confirm-ok-hover-border": "rgba(154, 115, 40, 0.46)"
    },
    "fontFamily": "\"Noto Serif SC\", \"Source Han Serif CN\", \"Songti SC\", \"STSong\", \"SimSun\", serif",
    "customCSS": "/* 鎏金·晨光：header 前缀金印 */\n#popup .acu-header::before {\n    content: '典';\n    display: inline-flex;\n    align-items: center;\n    justify-content: center;\n    width: 22px;\n    height: 22px;\n    border: 1px solid var(--acu-accent);\n    color: var(--acu-accent);\n    font-size: 12px;\n    border-radius: 3px;\n    opacity: 0.9;\n    letter-spacing: 1px;\n    flex-shrink: 0;\n}\n#popup .acu-header {\n    background: linear-gradient(180deg, rgba(154, 115, 40, 0.05), transparent);\n    box-shadow: none;\n    border-bottom: 1px solid rgba(154, 115, 40, 0.20);\n}\n/* 金色聚焦描边 */\n#popup input:focus, #popup textarea:focus, #popup select:focus {\n    outline: 1px solid rgba(154, 115, 40, 0.50);\n    outline-offset: -1px;\n}\n/* 表头淡金染色 */\n#popup table th {\n    background: rgba(154, 115, 40, 0.06);\n}",
    "windowChromeVariables": {
      "--acu-panel-bg": "var(--acu-bg-1)",
      "--acu-panel-border": "var(--acu-border)",
      "--acu-panel-text": "var(--acu-text-1)",
      "--acu-panel-text-dim": "var(--acu-text-2)",
      "--acu-panel-text-mute": "var(--acu-text-3)",
      "--acu-panel-accent": "var(--acu-accent)",
      "--acu-panel-hover": "var(--acu-bg-2)",
      "--acu-panel-shadow": "var(--acu-shadow)",
      "--acu-panel-close-hover-bg": "var(--acu-danger-soft-bg)",
      "--acu-panel-close-hover-border": "var(--acu-danger-soft-border)",
      "--acu-panel-close-hover-text": "var(--acu-danger)"
    },
    "toastVariables": {},
    "visualizerVariables": {},
    "previewColors": {
      "bg": "#f6f2e9",
      "card": "#fffcf5",
      "accent": "#9a7328",
      "text": "#353026"
    }
  }
}
